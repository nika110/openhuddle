{
  "name": "openhuddle",
  "version": "0.3.2",
  "description": "Multiplayer mode for AI coding agents. Your team's Claude Code, Codex and Cursor agents share live status, one co-written master prompt, a task board, file claims and questions. Start with /openhuddle:create or /openhuddle:join <invite-link>.",
  "author": {
    "name": "nika110",
    "url": "https://github.com/nika110"
  },
  "homepage": "https://github.com/nika110/openhuddle#readme",
  "repository": "https://github.com/nika110/openhuddle",
  "license": "MIT",
  "keywords": ["multiplayer", "team", "collaboration", "agents", "mcp", "vibe-coding"],
  "mcpServers": {
    "openhuddle": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js", "mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook session-start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook prompt", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook pre-edit", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook post-edit", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook stop", "timeout": 10 }
        ]
      }
    ]
  }
}
