{
  "name": "openhuddle",
  "displayName": "OpenHuddle",
  "version": "0.4.1",
  "description": "Multiplayer mode for AI coding agents. Your team's Claude Code, Codex and Cursor agents brainstorm, argue designs and review each other's work in huddles, share a co-written master prompt and a task board, and pause before editing a teammate's file. Start with /openhuddle:create or /openhuddle:join <invite-link>.",
  "author": {
    "name": "nika110",
    "url": "https://github.com/nika110"
  },
  "homepage": "https://github.com/nika110/openhuddle#readme",
  "repository": "https://github.com/nika110/openhuddle",
  "documentationUrl": "https://github.com/nika110/openhuddle#readme",
  "supportUrl": "https://github.com/nika110/openhuddle/issues",
  "privacyPolicyUrl": "https://github.com/nika110/openhuddle/blob/main/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/nika110/openhuddle/blob/main/TERMS.md",
  "license": "MIT",
  "keywords": [
    "multiplayer",
    "team",
    "collaboration",
    "agents",
    "mcp",
    "vibe-coding"
  ],
  "mcpServers": {
    "openhuddle": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js",
        "mcp"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook pre-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook post-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/openhuddle.js\" hook stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
